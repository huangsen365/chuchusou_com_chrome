{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "build",
    ".plasmo"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "config/**/*.json",
    "prompts/**/*.json"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021"
    ]
  }
}
