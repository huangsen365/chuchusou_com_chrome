{
  "version": "2.0",
  "description": "触触搜统一菜单配置 - 整合所有菜单定义",

  "constants": {
    "maxParamLength": 80,
    "maxDisplayLength": 20,
    "defaultContexts": ["selection", "page"],
    "editableContexts": ["selection", "page", "editable"]
  },

  "root": {
    "id": "ccs-main",
    "title": "触触搜",
    "icon": "🔍",
    "contexts": ["all"],
    "dynamicTitle": true,
    "titleTemplate": "${icon} ${title}"
  },

  "groups": [
    {
      "id": "fastQaQuick",
      "name": "快速问答快捷菜单",
      "position": "top",
      "separator": "after",
      "items": [
        {
          "id": "ccs-fastqa-chatgpt-quick",
          "type": "fastqa-quick",
          "title": "触触搜 · 速答壹拾佰 - ChatGPT",
          "icon": "🤖",
          "engineId": "chatgpt",
          "titleKey": "chatgpt",
          "dynamicTitle": true,
          "contexts": ["selection", "page", "editable"],
          "urlPattern": "https://chatgpt.com/?model=gpt-5&q=${PROMPT}",
          "enabled": true
        },
        {
          "id": "ccs-fastqa-claude-quick",
          "type": "fastqa-quick",
          "title": "触触搜 · 速答壹拾佰 - Claude",
          "icon": "🧠",
          "engineId": "claude",
          "titleKey": "claude",
          "dynamicTitle": true,
          "contexts": ["selection", "page", "editable"],
          "urlPattern": "https://claude.ai/new?q=${PROMPT}",
          "enabled": true
        },
        {
          "id": "ccs-fastqa-grok-quick",
          "type": "fastqa-quick",
          "title": "触触搜 · 速答壹拾佰 - Grok",
          "icon": "🦊",
          "engineId": "grok",
          "titleKey": "grok",
          "dynamicTitle": true,
          "contexts": ["selection", "page", "editable"],
          "urlPattern": "https://grok.com/?q=${PROMPT}",
          "enabled": true
        },
        {
          "id": "ccs-fastqa-yiyan-quick",
          "type": "fastqa-quick",
          "title": "触触搜 · 速答壹拾佰 - 文心一言",
          "icon": "🧠",
          "engineId": "yiyan",
          "titleKey": "yiyan",
          "dynamicTitle": true,
          "contexts": ["selection", "page", "editable"],
          "urlPattern": "https://yiyan.baidu.com/?q=${PROMPT}",
          "enabled": true
        }
      ]
    },
    {
      "id": "search",
      "name": "搜索引擎组",
      "position": "middle",
      "separator": "after",
      "items": [
        {
          "id": "ccs-baidu",
          "type": "search",
          "title": "百度搜索",
          "icon": "🐼",
          "contexts": ["selection", "page"],
          "urlPattern": "https://www.baidu.com/s?wd=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-google",
          "type": "search",
          "title": "Google 搜索",
          "icon": "🔎",
          "contexts": ["selection", "page"],
          "urlPattern": "https://www.google.com/search?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-tongyi",
          "type": "ai-search",
          "title": "通义千问",
          "icon": "🪄",
          "contexts": ["selection", "page"],
          "urlPattern": "https://tongyi.aliyun.com/qianwen/?q=${KEYWORD}",
          "enabled": true
        }
      ]
    },
    {
      "id": "ai",
      "name": "AI 对话组",
      "position": "middle",
      "separator": "none",
      "items": [
        {
          "id": "ccs-chatgpt",
          "type": "ai-chat",
          "title": "ChatGPT",
          "icon": "🤖",
          "dynamicTitle": true,
          "contexts": ["selection", "page"],
          "urlPattern": "https://chatgpt.com/?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-claude",
          "type": "ai-chat",
          "title": "Claude",
          "icon": "🧠",
          "dynamicTitle": true,
          "contexts": ["selection", "page"],
          "urlPattern": "https://claude.ai/new?q=${KEYWORD}",
          "enabled": true
        }
      ]
    },
    {
      "id": "general",
      "name": "通用搜索组",
      "position": "middle",
      "separator": "before",
      "items": [
        {
          "id": "ccs-yiyan",
          "type": "ai-search",
          "title": "文心一言",
          "icon": "🧠",
          "contexts": ["selection", "page"],
          "urlPattern": "https://yiyan.baidu.com/?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-grok",
          "type": "ai-search",
          "title": "Grok",
          "icon": "🦊",
          "dynamicTitle": true,
          "contexts": ["selection", "page"],
          "urlPattern": "https://x.com/i/grok?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-zhihu",
          "type": "search",
          "title": "知乎搜索",
          "icon": "💡",
          "contexts": ["selection", "page"],
          "urlPattern": "https://www.zhihu.com/search?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-weixin",
          "type": "search",
          "title": "微信搜一搜",
          "icon": "💬",
          "contexts": ["selection", "page"],
          "urlPattern": "https://weixin.sogou.com/weixin?query=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-taobao",
          "type": "ecommerce",
          "title": "淘宝搜索",
          "icon": "🛒",
          "contexts": ["selection", "page"],
          "urlPattern": "https://s.taobao.com/search?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-jd",
          "type": "ecommerce",
          "title": "京东搜索",
          "icon": "🛍️",
          "contexts": ["selection", "page"],
          "urlPattern": "https://search.jd.com/Search?keyword=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-sov2ex",
          "type": "search",
          "title": "V2EX (sov2ex)",
          "icon": "💻",
          "contexts": ["selection", "page"],
          "urlPattern": "https://www.sov2ex.com/?q=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-google-translate",
          "type": "translate",
          "title": "Google 翻译",
          "icon": "🔁",
          "contexts": ["selection", "page"],
          "urlPattern": "https://translate.google.com/?sl=auto&tl=zh-CN&text=${KEYWORD}",
          "enabled": true
        },
        {
          "id": "ccs-chuchusou",
          "type": "portal",
          "title": "更多搜索引擎...",
          "icon": "🌐",
          "dynamicTitle": true,
          "contexts": ["selection", "page"],
          "urlPattern": "https://chuchusou.com/#/?keyword=${KEYWORD}",
          "enabled": true
        }
      ]
    },
    {
      "id": "advanced",
      "name": "高级功能组",
      "position": "bottom",
      "separator": "before",
      "conditional": true,
      "items": [
        {
          "id": "ccs-top100-root",
          "type": "submenu",
          "title": "触触搜百问",
          "icon": "💯",
          "contexts": ["selection", "page"],
          "enabled": false,
          "children": [
            {
              "id": "ccs-top100-open-all",
              "type": "action",
              "title": "打开以下全部",
              "icon": "🚀",
              "contexts": ["selection", "page"]
            },
            {
              "id": "ccs-top100-yiyan",
              "type": "top100",
              "title": "文心一言",
              "icon": "🧠",
              "engineId": "yiyan",
              "titleKey": "yiyan",
              "dynamicTitle": true,
              "contexts": ["selection", "page"],
              "urlPattern": "https://yiyan.baidu.com/?q=${PROMPT}",
              "enabled": true
            }
          ]
        },
        {
          "id": "ccs-fastqa-root",
          "type": "submenu",
          "title": "速答壹拾佰",
          "icon": "⚡",
          "dynamicTitle": true,
          "contexts": ["selection", "page"],
          "enabled": false,
          "children": [
            {
              "id": "ccs-fastqa-open-all",
              "type": "action",
              "title": "打开以下全部",
              "icon": "🚀",
              "contexts": ["selection", "page"]
            },
            {
              "id": "ccs-fastqa-yiyan",
              "type": "fastqa",
              "title": "触触搜 · 速答壹拾佰 - 文心一言",
              "icon": "🧠",
              "engineId": "yiyan",
              "titleKey": "yiyan",
              "dynamicTitle": true,
              "contexts": ["selection", "page"],
              "urlPattern": "https://yiyan.baidu.com/?q=${PROMPT}",
              "enabled": true
            }
          ]
        },
        {
          "id": "ccs-optimize-root",
          "type": "submenu",
          "title": "优化提示词",
          "icon": "🧠",
          "contexts": ["selection", "page"],
          "enabled": false,
          "children": []
        }
      ]
    },
    {
      "id": "tools",
      "name": "工具组",
      "position": "bottom",
      "separator": "before",
      "items": [
        {
          "id": "ccs-copy",
          "type": "tool",
          "title": "复制文本",
          "icon": "📋",
          "contexts": ["selection"],
          "action": "copy",
          "enabled": true
        },
        {
          "id": "ccs-base64",
          "type": "tool",
          "title": "Base64 编码",
          "icon": "🔤",
          "contexts": ["selection"],
          "action": "base64-encode",
          "enabled": true
        },
        {
          "id": "ccs-md5",
          "type": "tool",
          "title": "MD5 哈希",
          "icon": "🔐",
          "contexts": ["selection"],
          "action": "md5-hash",
          "enabled": true
        },
        {
          "id": "ccs-url-encode",
          "type": "tool",
          "title": "URL 编码",
          "icon": "🔗",
          "contexts": ["selection"],
          "action": "url-encode",
          "enabled": true
        }
      ]
    },
    {
      "id": "transform",
      "name": "文本转换组",
      "position": "bottom",
      "separator": "before",
      "items": [
        {
          "id": "ccs-upper",
          "type": "transform",
          "title": "转换为大写",
          "icon": "🔠",
          "contexts": ["selection"],
          "action": "to-uppercase",
          "enabled": true
        },
        {
          "id": "ccs-lower",
          "type": "transform",
          "title": "转换为小写",
          "icon": "🔡",
          "contexts": ["selection"],
          "action": "to-lowercase",
          "enabled": true
        }
      ]
    },
    {
      "id": "panel",
      "name": "面板控制",
      "position": "bottom",
      "separator": "before",
      "items": [
        {
          "id": "ccs-show-popover",
          "type": "action",
          "title": "打开触触搜面板 (Alt+S)",
          "icon": "🪟",
          "contexts": ["all"],
          "action": "show-popover",
          "enabled": true
        }
      ]
    }
  ],

