{
  "manifest_version": 3,
  "name": "触触搜",
  "version": "1.1.0",
  "description": "选中文本快速搜索和处理工具",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modules/utils.js",
        "modules/toast.js",
        "modules/stateManager.js",
        "modules/settings.js",
        "modules/settingsPanel.js",
        "modules/blacklist.js",
        "modules/keywordExtractor.js",
        "modules/realtimeUpdate.js",
        "modules/recoveryPopover.js",
        "modules/buttonDefinitions.js",
        "modules/backgroundComm.js",
        "modules/selection.js",
        "modules/buttons.js",
        "modules/search.js",
        "modules/shortcuts.js",
        "modules/dragging.js",
        "modules/commands.js",
        "modules/textSync.js",
        "modules/positioning.js",
        "modules/domMonitor.js",
        "modules/suggestions.js",
        "dockbar.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "触触搜",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
