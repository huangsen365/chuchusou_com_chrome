{
  "manifest_version": 3,
  "name": "触触搜 - 多 AI 速答、封面生成器、提示词优化",
  "version": "1.3.1",
  "description": "选中文本快速搜索和处理工具，含封面生成器（内置小红书 / 椰树牌风格）",
  "homepage_url": "https://chuchusou.com",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/SelectionManager.js",
        "content/TextEncoder.js",
        "content/ToastUI.js",
        "content/ClipboardHelper.js",
        "modules/utils.js",
        "modules/toast.js",
        "modules/stateManager.js",
        "modules/settings.js",
        "modules/settingsPanel.js",
        "modules/blacklist.js",
        "modules/keywordExtractor.js",
        "modules/realtimeUpdate.js",
        "modules/recoveryPopover.js",
        "modules/buttonDefinitions.js",
        "modules/backgroundComm.js",
        "modules/selection.js",
        "modules/buttons.js",
        "modules/search.js",
        "modules/shortcuts.js",
        "modules/dragging.js",
        "modules/commands.js",
        "modules/textSync.js",
        "modules/positioning.js",
        "modules/domMonitor.js",
        "dockbar.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "触触搜",
    "default_icon": {
      "16": "icons/16x16.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
