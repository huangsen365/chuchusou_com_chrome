{
  "manifest_version": 3,
  "name": "触触搜 - ChatGPT Images 2.5 封面生成器 / 多 AI 速答 / 提示词优化",
  "version": "1.14.3",
  "description": "基于 ChatGPT Images 2.5 的封面生成器（极简留白 / 小红书 / 椰树牌 / 二次元可爱）+ 多 AI 速答 + 文本快速搜索处理",
  "homepage_url": "https://chuchusou.com",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel",
    "offscreen",
    "webRequest"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/SelectionManager.js",
        "content/TextEncoder.js",
        "content/ToastUI.js",
        "content/ClipboardHelper.js",
        "modules/utils.js",
        "modules/toast.js",
        "modules/stateManager.js",
        "modules/settings.js",
        "modules/settingsPanel.js",
        "modules/blacklist.js",
        "modules/keywordExtractor.js",
        "modules/realtimeUpdate.js",
        "modules/recoveryPopover.js",
        "modules/buttonDefinitions.js",
        "modules/backgroundComm.js",
        "modules/selection.js",
        "modules/buttons.js",
        "modules/search.js",
        "modules/shortcuts.js",
        "modules/dragging.js",
        "modules/commands.js",
        "modules/textSync.js",
        "modules/positioning.js",
        "modules/domMonitor.js",
        "shared/promptLanguage.js",
        "shared/rewriteVariety.js",
        "modules/siteFastQaRuntime.js",
        "modules/xTweetFastQa.js",
        "modules/zhihuFastQa.js",
        "modules/articleRewriteRuntime.js",
        "modules/googleDocsRewrite.js",
        "modules/chatGptSelectARewrite.js",
        "modules/longArticleActions.js",
        "modules/xArticleDraftDelivery.js",
        "dockbar.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://x.com/compose/articles*",
        "https://www.x.com/compose/articles*"
      ],
      "js": [
        "modules/xArticleMainWorld.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "触触搜",
    "default_icon": {
      "16": "icons/16x16.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
